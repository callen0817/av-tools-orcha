<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="AV Orch"
           Manufacturer="Artificial Vision, Inc."
           Version="1.0.0.0"
           UpgradeCode="7B8E4C19-3A2D-4D62-9E15-88A40C29F1B4"
           Scope="perUser"
           InstallerVersion="500">

    <MajorUpgrade DowngradeErrorMessage="A newer version of AV Orch is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="AV_ORCH_CLEAN_MCP_ON_UNINSTALL" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="CompanyFolder" Name="Artificial Vision">
        <Directory Id="INSTALLFOLDER" Name="AV Orch" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="AV Orch" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="AV Orch Desktop Connector" Level="1">
      <ComponentRef Id="AvOrchExecutable" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <Component Id="AvOrchExecutable" Directory="INSTALLFOLDER" Guid="9F2C6B14-8A3E-4C1B-9E71-54D02B8A6C31">
      <File Id="AvOrchExeFile" Source="$(var.PublishDir)\AVOrch.exe" />
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
      <RemoveFolder Id="RemoveCompanyFolder" Directory="CompanyFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Artificial Vision\AV Orch" Name="InstallPath" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
    </Component>

    <Component Id="ApplicationShortcut" Directory="ApplicationProgramsFolder" Guid="3E9A5F12-6C4D-4A9E-B184-21F9E3C77A10">
      <Shortcut Id="ApplicationStartMenuShortcut"
                Name="AV Orch"
                Description="Artificial Vision Revit AI Connector"
                Target="[INSTALLFOLDER]AVOrch.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Artificial Vision\AV Orch" Name="ShortcutInstalled" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Install AV Orch into the shared AV Tools Revit ribbon by default (preserves NX Xplode & other AV Tools) -->
    <CustomAction Id="InstallAvToolsRibbon"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]AVOrch.exe&quot; --install-ribbon"
                  Execute="immediate"
                  Return="ignore" />

    <!-- Optional clean uninstall action: removes ONLY AV Orch-owned MCP registrations and AV Orch ribbon button -->
    <CustomAction Id="CleanupAvOrchMcpRegistrations"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]AVOrch.exe&quot; --uninstall-cleanup"
                  Execute="immediate"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="InstallAvToolsRibbon"
              After="InstallFinalize"
              Condition="NOT REMOVE" />
      <Custom Action="CleanupAvOrchMcpRegistrations"
              Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND AV_ORCH_CLEAN_MCP_ON_UNINSTALL=&quot;1&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
