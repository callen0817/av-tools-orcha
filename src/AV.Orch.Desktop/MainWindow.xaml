<Window x:Class="AV.Orch.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AV Orch — Artificial Vision Revit AI Connector"
        Width="1120"
        Height="740"
        MinWidth="920"
        MinHeight="620"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Margin="18,22,18,18">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="4" Background="{DynamicResource AccentGoldBrush}" Margin="0,0,10,0">
                            <TextBlock Text="AV" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="AV Orch" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Text="{Binding AppVersion}" FontSize="11" Foreground="{DynamicResource AccentGoldBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Artificial Vision, Inc." FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="8,6,8,0">
                    <Button Content="Home" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Home"/>
                    <Button Content="Providers" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Providers"/>
                    <Button Content="Revit" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Revit"/>
                    <Button Content="Permissions" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Permissions"/>
                    <Button Content="Diagnostics" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Diagnostics"/>
                    <Button Content="Settings" Style="{StaticResource NavButtonStyle}" Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,18">
                    <Button Content="Refresh Status" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RefreshCommand}" Margin="0,0,0,8"/>
                    <Button Content="Test Revit (Read-Only)" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding TestRevitCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Workspace -->
        <DockPanel Grid.Column="1">
            <!-- Status Banner -->
            <Border DockPanel.Dock="Bottom"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="18,10">
                <TextBlock Text="{Binding StatusBanner}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
                <StackPanel>
                    <!-- HOME VIEW -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Home">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Home" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Connect OpenAI Codex, Google Gemini CLI, and Anthropic Claude Code to your active Autodesk Revit session via local MCP." Style="{StaticResource BodyTextStyle}" Margin="0,0,0,16"/>

                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                                    <TextBlock Text="Revit Connection" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="{Binding RevitConnectionSummary}" Style="{StaticResource BodyTextStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                    <TextBlock Text="Active Revit Document" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="{Binding ActiveDocumentSummary}" Style="{StaticResource BodyTextStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="pyRevit MCP Runtime" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="{Binding PyRevitStateSummary}" Style="{StaticResource BodyTextStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Text="Connection Health" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="{Binding ConnectionHealthSummary}" Style="{StaticResource BodyTextStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Last Diagnostic Result" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="{Binding LastDiagnosticSummary}" Style="{StaticResource BodyTextStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Background="{DynamicResource AccentGoldSoftBrush}">
                            <StackPanel>
                                <TextBlock Text="Privacy &amp; Model Confidentiality" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="{Binding ModelDataNotice}" Style="{StaticResource BodyTextStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- PROVIDERS VIEW -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Providers">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="AI Providers" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Configure one or all three AI assistants independently. Connecting one provider never removes another." Style="{StaticResource BodyTextStyle}" Margin="0,0,0,16"/>

                        <ItemsControl ItemsSource="{Binding Providers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                                                <TextBlock Text="{Binding Detection.Status}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentGoldBrush}" FontWeight="SemiBold"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Detection.Message}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Authentication.Message}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Registration.Message}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,12"/>
                                            <WrapPanel>
                                                <Button Content="Sign In" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                                        Command="{Binding DataContext.SignInProviderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Provider}"/>
                                                <Button Content="Connect" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"
                                                        Command="{Binding DataContext.ConnectProviderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Provider}"/>
                                                <Button Content="Disconnect" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                                                        Command="{Binding DataContext.DisconnectProviderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Provider}"/>
                                                <Button Content="Reconnect / Repair" Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding DataContext.RepairProviderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Provider}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- REVIT VIEW -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Revit">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Autodesk Revit &amp; pyRevit" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Detected Revit installations, active sessions, and pyRevit MCP runtime status." Style="{StaticResource BodyTextStyle}" Margin="0,0,0,16"/>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="pyRevit MCP Runtime" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="{Binding PyRevitStateSummary}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,12"/>
                                <Button Content="Run Read-Only Revit Connection Test" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Command="{Binding TestRevitCommand}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Installed Revit Versions" Style="{StaticResource SectionTitleStyle}"/>
                                <ItemsControl ItemsSource="{Binding RevitInstallations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,2">
                                                <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text=" — "/>
                                                <Run Text="{Binding InstallDirectory, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Running Revit Sessions" Style="{StaticResource SectionTitleStyle}"/>
                                <ItemsControl ItemsSource="{Binding RevitSessions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,2">
                                                <Run Text="PID "/>
                                                <Run Text="{Binding ProcessId, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text=" | Revit "/>
                                                <Run Text="{Binding RevitYear, Mode=OneWay}"/>
                                                <Run Text=" | Doc: "/>
                                                <Run Text="{Binding ActiveDocumentTitle, Mode=OneWay}"/>
                                                <Run Text=" | Policy: "/>
                                                <Run Text="{Binding AgentPolicy, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- PERMISSIONS VIEW -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Permissions">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Permissions &amp; Model Safety" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Control whether connected AI assistants may only query Revit or propose changes for your approval inside Revit." Style="{StaticResource BodyTextStyle}" Margin="0,0,0,16"/>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Active Revit Modification Policy" Style="{StaticResource SectionTitleStyle}"/>
                                <RadioButton Content="Read-Only (Default) — Model queries and dry runs only; model changes are rolled back."
                                             IsChecked="{Binding IsReadOnlyPolicy}" Margin="0,6" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <RadioButton Content="Ask Before Modifications — AI may propose edits; every edit requires Keep/Discard approval inside Revit."
                                             IsChecked="{Binding IsAskPolicy}" Margin="0,6,0,14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <Button Content="Apply Permission Policy" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Command="{Binding ApplyPermissionPolicyCommand}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Important Execution &amp; Security Boundaries" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="{Binding PythonExecutionNotice}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding NativeApprovalNotice}" Style="{StaticResource BodyTextStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- DIAGNOSTICS VIEW -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Diagnostics">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Diagnostics &amp; Safe Repair" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Review detected issues and run safe, reversible repair actions." Style="{StaticResource BodyTextStyle}" Margin="0,0,0,16"/>

                        <ItemsControl ItemsSource="{Binding DiagnosticIssues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitleStyle}" Margin="0"/>
                                                <TextBlock Text="{Binding Severity}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentGoldBrush}" FontWeight="SemiBold"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding RecoveryAction}" Style="{StaticResource BodyTextStyle}" FontStyle="Italic" Margin="0,0,0,8"/>
                                            <Button Content="Run Safe Repair" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left"
                                                    Command="{Binding DataContext.RunRepairActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding RepairActionId}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- SETTINGS VIEW -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSection}" Value="Settings">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Settings &amp; Maintenance" Style="{StaticResource PageTitleStyle}"/>
                        <TextBlock Text="Local preferences, theme, logs, backups, and uninstall cleanup." Style="{StaticResource BodyTextStyle}" Margin="0,0,0,16"/>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Preferences" Style="{StaticResource SectionTitleStyle}"/>
                                <CheckBox Content="Dark Theme" IsChecked="{Binding DarkTheme}" Margin="0,4" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <CheckBox Content="Launch AV Orch at Windows sign-in" IsChecked="{Binding LaunchAtStartup}" Margin="0,4" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <CheckBox Content="Check for AV Orch updates" IsChecked="{Binding CheckForUpdates}" Margin="0,4,0,12" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                <WrapPanel>
                                    <Button Content="Save Settings" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Command="{Binding SaveSettingsCommand}"/>
                                    <Button Content="Restore Defaults" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RestoreDefaultsCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Local Storage &amp; Uninstall Cleanup" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,4">
                                    <Run Text="Settings File: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding SettingsPath, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,0,0,12">
                                    <Run Text="Redacted Logs Directory: " FontWeight="SemiBold"/>
                                    <Run Text="{Binding LogDirectory, Mode=OneWay}"/>
                                </TextBlock>
                                <Button Content="Remove All AV Orch MCP Registrations" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Command="{Binding CleanAvOrchRegistrationsCommand}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Recent Local Audit History" Style="{StaticResource SectionTitleStyle}"/>
                                <ItemsControl ItemsSource="{Binding AuditEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,2">
                                                <Run Text="{Binding TimestampUtc, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}Z}"/>
                                                <Run Text=" | "/>
                                                <Run Text="{Binding Action, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text=" -> "/>
                                                <Run Text="{Binding Summary, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="About AV Orch" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Text="AV Orch v1.0.0 — Artificial Vision, Inc. No telemetry is collected. No Autodesk, OpenAI, Google, or Anthropic endorsement is implied." Style="{StaticResource BodyTextStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
